# Template only — DO NOT put real keys here. This file IS committed to git.
# Put your real key in ".env" instead (that file is gitignored).
#
# Google Gemini API key for the portfolio AI chat assistant.
# Get a free key at https://aistudio.google.com/apikey
# Local dev: copy this file to ".env" and fill in the value there.
# Production (Vercel): add GEMINI_API_KEY in Project → Settings → Environment Variables.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional: extra origins allowed to call /api/chat (comma-separated).
# The endpoint already allows requests from its own domain automatically;
# only set this if you embed the chat on another domain.
# ALLOWED_ORIGINS=https://yourcustomdomain.com
