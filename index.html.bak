<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bunyarit Jerdrujikul — Software Engineer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --ink: #0d0d0d;
      --ink-2: #444;
      --ink-3: #888;
      --rule: #e8e8e8;
      --bg: #fafafa;
      --white: #ffffff;
      --accent: #1a56db;
      --accent-light: #e8f0fe;
      --green: #0d7a4e;
      --green-bg: #e6f4ee;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--ink);
      font-size: 15px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Nav ── */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      height: 60px;
      background: rgba(250, 250, 250, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--rule);
    }

    .nav-logo {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      color: var(--ink);
      text-decoration: none;
      letter-spacing: 0.05em;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      font-size: 13px;
      color: var(--ink-2);
      text-decoration: none;
      letter-spacing: 0.02em;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .nav-cta {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      padding: 7px 16px;
      background: var(--ink);
      color: #fff;
      border-radius: 4px;
      text-decoration: none;
      transition: background 0.2s;
    }

    .nav-cta:hover {
      background: var(--accent);
    }

    /* ── Sections ── */
    section {
      padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 8vw, 8rem);
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
    }

    /* ── Hero ── */
    #hero {
      padding-top: calc(60px + clamp(4rem, 8vw, 7rem));
      min-height: 100svh;
      display: flex;
      align-items: center;
    }

    .hero-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      color: var(--accent);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 1.2rem;
      opacity: 0;
      animation: fadeUp 0.6s 0.1s forwards;
    }

    .hero-name {
      font-family: 'Inter', sans-serif;
      font-size: clamp(3rem, 8vw, 6.5rem);
      line-height: 1.0;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: fadeUp 0.6s 0.2s forwards;
    }

    .hero-name em {
      font-style: italic;
      color: var(--accent);
    }

    .hero-sub {
      max-width: 520px;
      font-size: 16px;
      color: var(--ink-2);
      line-height: 1.75;
      margin-bottom: 2.5rem;
      opacity: 0;
      animation: fadeUp 0.6s 0.35s forwards;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      opacity: 0;
      animation: fadeUp 0.6s 0.45s forwards;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 11px 24px;
      border-radius: 5px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--ink);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--accent);
      transform: translateY(-1px);
    }

    .btn-ghost {
      border: 1px solid var(--rule);
      color: var(--ink);
      background: var(--white);
    }

    .btn-ghost:hover {
      border-color: var(--ink-2);
      transform: translateY(-1px);
    }

    .hero-meta {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--rule);
      display: flex;
      gap: 2.5rem;
      flex-wrap: wrap;
      opacity: 0;
      animation: fadeUp 0.6s 0.55s forwards;
    }

    .hero-meta-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .hero-meta-label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      color: var(--ink-3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .hero-meta-value {
      font-size: 14px;
      color: var(--ink);
      font-weight: 500;
    }

    /* ── Section Header ── */
    .sec-label {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      color: var(--ink-3);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      margin-bottom: 0.6rem;
    }

    .sec-title {
      font-family: 'Inter', sans-serif;
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin-bottom: 3rem;
    }

    /* ── About ── */
    #about {
      background: var(--white);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
    }

    .about-text p {
      color: var(--ink-2);
      line-height: 1.8;
      margin-bottom: 1rem;
    }

    .about-text p:last-child {
      margin-bottom: 0;
    }

    .about-aside {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .about-card {
      background: var(--bg);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      border: 1px solid var(--rule);
    }

    .about-card-label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      color: var(--ink-3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.5rem;
    }

    .about-card-value {
      font-size: 14px;
      color: var(--ink);
      line-height: 1.6;
    }

    /* ── Experience ── */
    #experience {
      background: var(--bg);
    }

    .exp-list {
      display: flex;
      flex-direction: column;
    }

    .exp-item {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 2rem;
      padding: 2rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .exp-item:first-child {
      border-top: 1px solid var(--rule);
    }

    .exp-date {
      font-family: 'Inter', sans-serif;
      font-size: 11.5px;
      color: var(--ink-3);
      padding-top: 3px;
    }

    .exp-role {
      font-size: 16px;
      font-weight: 500;
      color: var(--ink);
      margin-bottom: 3px;
    }

    .exp-company {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }

    .exp-desc {
      color: var(--ink-2);
      font-size: 14px;
      line-height: 1.75;
      margin-bottom: 0.75rem;
    }

    .exp-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }

    .tag {
      font-family: 'Inter', sans-serif;
      font-size: 10.5px;
      padding: 3px 8px;
      border-radius: 3px;
      border: 1px solid var(--rule);
      color: var(--ink-2);
      background: var(--white);
    }

    .tag-accent {
      border-color: #c7d9fb;
      color: var(--accent);
      background: var(--accent-light);
    }

    .badge-founder {
      display: inline-flex;
      align-items: center;
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      padding: 2px 8px;
      background: #fef3e2;
      color: #92400e;
      border: 1px solid #f59e0b;
      border-radius: 3px;
      margin-left: 8px;
      vertical-align: middle;
    }

    /* ── Projects ── */
    #projects {
      background: var(--white);
    }

    .proj-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .proj-card {
      border: 1px solid var(--rule);
      border-radius: 8px;
      padding: 1.75rem;
      background: var(--bg);
      transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
      display: flex;
      flex-direction: column;
    }

    .proj-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
      border-color: #d0d8e8;
    }

    .proj-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
    }

    .proj-type {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      color: var(--ink-3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.4rem;
    }

    .proj-name {
      font-size: 15px;
      font-weight: 500;
      color: var(--ink);
      line-height: 1.3;
    }

    .proj-link {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      color: var(--accent);
      text-decoration: none;
      white-space: nowrap;
      padding: 3px 8px;
      border: 1px solid #c7d9fb;
      border-radius: 3px;
      background: var(--accent-light);
      transition: background 0.2s;
      flex-shrink: 0;
    }

    .proj-link:hover {
      background: #d0e4fd;
    }

    .proj-desc {
      font-size: 13.5px;
      color: var(--ink-2);
      line-height: 1.7;
      margin: 0.75rem 0;
      flex: 1;
    }

    .proj-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: auto;
    }

    .proj-tag {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 2px;
      background: #eeeeee;
      color: var(--ink-2);
    }

    /* ── Skills ── */
    #skills {
      background: var(--bg);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .skill-group-label {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      color: var(--ink-3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--rule);
    }

    .skill-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }

    .chip {
      font-size: 12.5px;
      padding: 4px 10px;
      border-radius: 4px;
      background: var(--white);
      border: 1px solid var(--rule);
      color: var(--ink-2);
    }

    .chip-core {
      background: var(--accent-light);
      border-color: #c7d9fb;
      color: #1a3a7c;
    }

    .chip-green {
      background: var(--green-bg);
      border-color: #9ed4be;
      color: var(--green);
    }

    /* ── Contact ── */
    #contact {
      background: var(--ink);
      color: #fff;
    }

    #contact .sec-label {
      color: #888;
    }

    #contact .sec-title {
      color: #fff;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
    }

    .contact-sub {
      color: #aaa;
      line-height: 1.8;
      margin-bottom: 2rem;
      font-size: 15px;
    }

    .contact-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .contact-link {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #ccc;
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }

    .contact-link:hover {
      color: #fff;
    }

    .contact-link-icon {
      width: 34px;
      height: 34px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .contact-aside {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .contact-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
    }

    .contact-card-label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.4rem;
    }

    .contact-card-value {
      font-size: 14px;
      color: #ddd;
    }

    .status-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #4ade80;
      margin-right: 6px;
      animation: pulse 2s infinite;
    }

    /* ── Footer ── */
    footer {
      background: #080808;
      padding: 1.5rem clamp(1.5rem, 8vw, 8rem);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    footer span {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      color: #444;
    }

    /* ── Animations ── */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.4;
      }
    }

    .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.55s ease, transform 0.55s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: none;
    }

    /* ── Activities ── */
    #activities {
      background: var(--bg);
    }

    .activities-filter {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    .filter-btn {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 500;
      padding: 6px 16px;
      border-radius: 100px;
      border: 1px solid var(--rule);
      background: var(--white);
      color: var(--ink-2);
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .filter-btn:hover {
      border-color: var(--ink-2);
      color: var(--ink);
    }

    .filter-btn.active {
      background: var(--ink);
      color: #fff;
      border-color: var(--ink);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .gallery-item {
      position: relative;
      border-radius: 10px;
      overflow: hidden;
      aspect-ratio: 4 / 3;
      cursor: pointer;
      border: 1px solid var(--rule);
      background: var(--white);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .gallery-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }

    .gallery-item:hover img {
      transform: scale(1.05);
    }

    .gallery-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 50%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.25rem;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .gallery-item:hover .gallery-overlay {
      opacity: 1;
    }

    .gallery-overlay-title {
      font-size: 14px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 2px;
    }

    .gallery-overlay-date {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.7);
      font-weight: 400;
    }

    .gallery-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #f0f2f5 0%, #e4e8ee 100%);
      color: var(--ink-3);
      gap: 0.5rem;
    }

    .gallery-placeholder svg {
      opacity: 0.4;
    }

    .gallery-placeholder span {
      font-size: 12px;
      font-weight: 500;
      opacity: 0.5;
    }

    /* Lightbox */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.92);
      backdrop-filter: blur(20px);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .lightbox.open {
      opacity: 1;
      pointer-events: all;
    }

    .lightbox-img {
      max-width: 85vw;
      max-height: 80vh;
      border-radius: 8px;
      object-fit: contain;
      transform: scale(0.9);
      transition: transform 0.35s ease;
    }

    .lightbox.open .lightbox-img {
      transform: scale(1);
    }

    .lightbox-caption {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      color: #fff;
    }

    .lightbox-caption-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .lightbox-caption-date {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.6);
    }

    .lightbox-close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }

    .lightbox-close:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }

    .lightbox-nav:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .lightbox-prev {
      left: 1.5rem;
    }

    .lightbox-next {
      right: 1.5rem;
    }

    /* ── Responsive ── */
    @media (max-width: 700px) {

      .about-grid,
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .proj-grid {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: 1fr 1fr;
      }

      .exp-item {
        grid-template-columns: 1fr;
        gap: 0.5rem;
      }

      .nav-links {
        display: none;
      }

      .gallery-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 480px) {
      .gallery-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- NAV -->
  <nav>
    <a class="nav-logo" href="#hero">bell77m</a>
    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#experience">Experience</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#skills">Skills</a></li>
      <li><a href="#activities">Activities</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <a class="nav-cta" href="mailto:bell77m@gmail.com">Hire me</a>
  </nav>

  <!-- HERO -->
  <section id="hero">
    <div class="container">
      <div class="hero-eyebrow">Software Engineer · Bangkok, Thailand</div>
      <h1 class="hero-name">Bunyarit<br><em>Jerdrujikul</em></h1>
      <p class="hero-sub">
        Computer Engineering student building full-stack products, open-source libraries, and security-hardened systems.
        Founded a 12-person software studio. Always writing code that ships.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#projects">View Projects</a>
        <a class="btn btn-ghost" href="https://github.com/bell77m" target="_blank">GitHub ↗</a>
        <a class="btn btn-ghost" href="https://www.linkedin.com/in/bunyarit-jerdrujikul-316520168"
          target="_blank">LinkedIn ↗</a>
      </div>
      <div class="hero-meta">
        <div class="hero-meta-item">
          <span class="hero-meta-label">Status</span>
          <span class="hero-meta-value"><span class="status-dot"></span>Open to work</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Graduating</span>
          <span class="hero-meta-value">2026 · B.Eng CPE</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Focus</span>
