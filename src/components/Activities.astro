---

<section id="activities">
  <div class="container">
    <div class="reveal">
      <div class="sec-label" data-i18n="act.label">Activities</div>
      <div class="sec-title" data-i18n="act.title">Events I've joined.</div>
    </div>

    <div class="activities-filter reveal">
      <button class="filter-btn active" data-filter="all" data-i18n="act.all">All</button>
      <button class="filter-btn" data-filter="hackathon" data-i18n="act.hackathon">Hackathon</button>
      <button class="filter-btn" data-filter="workshop" data-i18n="act.workshop">Workshop</button>
      <button class="filter-btn" data-filter="community" data-i18n="act.community">Community</button>
    </div>

    <div class="gallery-grid reveal">
      {
        activities.map((item, index) => (
          <div
            class="gallery-item"
            data-category={item.category}
            data-index={index}
          >
            <img src={item.images[0]} alt={item.title} />
            <div class="gallery-overlay">
              <div class="gallery-overlay-title">{item.title}</div>
              <div class="gallery-overlay-date">{item.date}</div>
              {item.images.length > 1 && (
                <span class="gallery-overlay-date">
                  + {item.images.length - 1} photos
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lightbox-close-btn">✕</button>
  <button class="lightbox-nav lightbox-prev" id="lightbox-prev-btn">‹</button>
  <button class="lightbox-nav lightbox-next" id="lightbox-next-btn">›</button>
  <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  <div class="lightbox-caption">
    <div class="lightbox-caption-title" id="lightbox-title"></div>
    <div class="lightbox-caption-date" id="lightbox-date"></div>
    <div class="lightbox-counter" id="lightbox-counter" style="display: none;">
    </div>
  </div>
</div>

<script define:vars={{ activities }}>
  // ── Activities filter ──
  const filterBtns = document.querySelectorAll(".filter-btn");
  const galleryItems = document.querySelectorAll(".gallery-item");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const filter = btn.dataset.filter;
      galleryItems.forEach((item) => {
        if (filter === "all" || item.dataset.category === filter) {
          item.style.display = "";
          item.style.animation = "fadeUp 0.4s ease forwards";
        } else {
          item.style.display = "none";
        }
      });
    });
  });

  // ── Lightbox ──
  let currentIndex = 0;
  let currentImgIndex = 0;
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxTitle = document.getElementById("lightbox-title");
  const lightboxDate = document.getElementById("lightbox-date");
  const lightboxCounter = document.getElementById("lightbox-counter");

  function openLightbox(i, imgIndex = 0) {
    currentIndex = i;
    currentImgIndex = imgIndex;
    const data = activities[i];
    if (!data.images || data.images.length === 0 || !data.images[0]) return;

    lightboxImg.src = data.images[currentImgIndex];
    lightboxTitle.textContent = data.title;
    lightboxDate.textContent = data.date;

    if (data.images.length > 1) {
      lightboxCounter.textContent = `${currentImgIndex + 1} / ${
        data.images.length
      }`;
      lightboxCounter.style.display = "block";
    } else {
      lightboxCounter.style.display = "none";
    }

    lightbox.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.remove("open");
    document.body.style.overflow = "";
  }

  function nextLightbox() {
    const data = activities[currentIndex];
    if (data.images.length > 1) {
      currentImgIndex = (currentImgIndex + 1) % data.images.length;
      openLightbox(currentIndex, currentImgIndex);
    } else {
      const next = (currentIndex + 1) % activities.length;
      if (activities[next].images[0]) openLightbox(next, 0);
    }
  }

  function prevLightbox() {
    const data = activities[currentIndex];
    if (data.images.length > 1) {
      currentImgIndex =
        (currentImgIndex - 1 + data.images.length) % data.images.length;
      openLightbox(currentIndex, currentImgIndex);
    } else {
      const prev = (currentIndex - 1 + activities.length) % activities.length;
      if (activities[prev].images[0]) openLightbox(prev, 0);
    }
  }

  // Event listeners
  galleryItems.forEach((item) => {
    item.addEventListener("click", () => {
      const index = parseInt(item.dataset.index);
      openLightbox(index);
    });
  });

  document
    .getElementById("lightbox-close-btn")
    .addEventListener("click", closeLightbox);
  document
    .getElementById("lightbox-prev-btn")
    .addEventListener("click", prevLightbox);
  document
    .getElementById("lightbox-next-btn")
    .addEventListener("click", nextLightbox);

  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (!lightbox.classList.contains("open")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowRight") nextLightbox();
    if (e.key === "ArrowLeft") prevLightbox();
  });
</script>
