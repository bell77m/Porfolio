<section id="activities">
  <div class="container">
    <div class="reveal">
      <div class="sec-label">Activities</div>
      <div class="sec-title">Events I've joined.</div>
    </div>

    <div class="activities-filter reveal">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="hackathon">Hackathon</button>
      <button class="filter-btn" data-filter="workshop">Workshop</button>
      <button class="filter-btn" data-filter="community">Community</button>
    </div>

    <div class="gallery-grid reveal">

      <div class="gallery-item" data-category="hackathon" data-index="0">
        <div class="gallery-placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="M21 15l-5-5L5 21" />
          </svg>
          <span>Stupid Hackathon #7</span>
        </div>
        <div class="gallery-overlay">
          <div class="gallery-overlay-title">Stupid Hackathon #7</div>
          <div class="gallery-overlay-date">2023 · Creatorsgarten</div>
        </div>
      </div>

      <div class="gallery-item" data-category="hackathon" data-index="1">
        <div class="gallery-placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="M21 15l-5-5L5 21" />
          </svg>
          <span>Stupid Hackathon #8</span>
        </div>
        <div class="gallery-overlay">
          <div class="gallery-overlay-title">Stupid Hackathon #8</div>
          <div class="gallery-overlay-date">2024 · Creatorsgarten</div>
        </div>
      </div>

      <div class="gallery-item" data-category="hackathon" data-index="2">
        <div class="gallery-placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="M21 15l-5-5L5 21" />
          </svg>
          <span>Hackathon Thailand League</span>
        </div>
        <div class="gallery-overlay">
          <div class="gallery-overlay-title">Hackathon Thailand League</div>
          <div class="gallery-overlay-date">2023 · TrueDigital</div>
        </div>
