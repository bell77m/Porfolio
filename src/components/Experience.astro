<section id="experience">
  <div class="container">
    <div class="reveal">
      <div class="sec-label" data-i18n="exp.label">Experience</div>
      <div class="sec-title" data-i18n="exp.title">Where I've worked.</div>
    </div>
    <div class="exp-list">

      <div class="exp-item reveal">
        <div class="exp-date">2026 – Present</div>
        <div>
          <div class="exp-role" data-i18n="exp.role.zettasoft">Full-Stack Developer</div>
          <div class="exp-company">Zettasoft · DPlus Group</div>
          <div class="exp-desc" data-i18n="exp.desc.zettasoft">Build and ship full-stack web applications while driving DevSecOps practices —
            embedding automated security testing into CI/CD pipelines. Currently developing an AI-powered MCP
            (Model Context Protocol) server that automates penetration-testing workflows, orchestrating
            reconnaissance, scanning, and reporting through LLM-driven tooling.</div>
          <div class="exp-tags">
            <span class="tag tag-accent">Full-stack</span>
            <span class="tag tag-accent">DevSecOps</span>
            <span class="tag tag-accent">AI · MCP</span>
            <span class="tag">CI/CD</span>
            <span class="tag">Automation</span>
            <span class="tag">Penetration Testing</span>
          </div>
        </div>
      </div>

      <div class="exp-item reveal">
        <div class="exp-date">2025 – Present</div>
        <div>
          <div class="exp-role" data-i18n-html="exp.role.compax">Freelance Web Developer & Founder <span class="badge-founder">Founder</span></div>
          <div class="exp-company">Compax Tech Solutions · Remote</div>
          <a class="exp-link" href="https://www.compaxtech.com/" target="_blank" rel="noopener" aria-label="Compax Tech Solutions website">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18" />
              <path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z" />
            </svg>
            compaxtech.com
          </a>
          <a class="exp-link" href="https://www.instagram.com/compax_tech.sol/" target="_blank" rel="noopener" aria-label="Compax Tech Solutions on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @compax_tech.sol
          </a>
          <div class="exp-desc" data-i18n="exp.desc.compax">Founded and led a 12-person software studio delivering full-stack applications
            end-to-end — from architecture and scoping to CI/CD deployment. Built reusable TypeScript + React
            component libraries that cut setup time by ~40% across projects. Integrated OWASP-based secure coding
            reviews into every sprint, resulting in zero post-launch vulnerability reports across all clients.</div>
          <div class="exp-tags">
            <span class="tag tag-accent">TypeScript</span>
            <span class="tag tag-accent">React</span>
            <span class="tag tag-accent">FastAPI</span>
            <span class="tag tag-accent">Docker</span>
            <span class="tag">Team Lead</span>
            <span class="tag">Full-stack</span>
          </div>
        </div>
      </div>

      <div class="exp-item reveal">
        <div class="exp-date">2025 – 2026</div>
        <div>
          <div class="exp-role" data-i18n="exp.role.intern">Software & Security Engineer Intern</div>
          <div class="exp-company">You And Earth (Thailand) Co., Ltd. · Bangkok</div>
          <div class="exp-desc" data-i18n="exp.desc.intern">Assessed 5+ production web applications for OWASP Top 10 vulnerabilities. Developed
            internal Python scripts to automate recon workflows. Authored technical reports with CVSS-rated findings
            and code-level remediation guides — 100% of critical issues resolved within sprint cycles.</div>
          <div class="exp-tags">
            <span class="tag tag-accent">Python</span>
            <span class="tag tag-accent">API Testing</span>
            <span class="tag">OWASP Top 10</span>
            <span class="tag">Web Security</span>
            <span class="tag">Technical Reporting</span>
          </div>
        </div>
      </div>

      <div class="exp-item reveal">
        <div class="exp-date">2021 – 2022</div>
        <div>
          <div class="exp-role" data-i18n="exp.role.farrmhub">Junior Web Developer</div>
          <div class="exp-company">Farrmhub Laos Co. · Laos (Remote)</div>
          <div class="exp-desc" data-i18n="exp.desc.farrmhub">Developed and maintained 10+ features for an agricultural platform using PHP and
            JavaScript. Redesigned relational database schemas and optimized queries, reducing errors by ~30% and
            improving data retrieval consistency across core workflows.</div>
