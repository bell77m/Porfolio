            <span class="tag tag-accent">PHP</span>
            <span class="tag tag-accent">JavaScript</span>
            <span class="tag">MySQL</span>
            <span class="tag">Database Design</span>
          </div>
        </div>
      </div>

      <div class="exp-item reveal">
        <div class="exp-date">2024 – 2025</div>
        <div>
          <div class="exp-role" data-i18n="exp.role.club">Founder & President — Cyber Geek Club</div>
          <div class="exp-company">Kasetsart University Sriracha Campus</div>
          <a class="exp-link" href="https://www.instagram.com/cybergeekclub.src/" target="_blank" rel="noopener" aria-label="Cyber Geek Club on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @cybergeekclub.src
          </a>
          <div class="exp-desc" data-i18n="exp.desc.club">Founded and led the university tech club with 30+ active members, organizing 5+
            workshops on programming, cybersecurity, and IoT — reaching 100+ students. Established the club as an
            official university tech community.</div>
          <div class="exp-tags">
            <span class="tag">Community</span>
            <span class="tag">Leadership</span>
            <span class="tag">Workshops</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
