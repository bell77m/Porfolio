  const LABELS: Record<string, string> = { en: 'EN', th: 'ไทย', zh: '中文' };
  const STORAGE_KEY = 'site-lang';

  const root = document.documentElement;
  const langEl = document.getElementById('lang');
  const btn = document.getElementById('lang-btn');
  const menu = document.getElementById('lang-menu');
  const current = document.getElementById('lang-current');

  // Cache the original English content for every tagged element.
  const nodes = Array.from(
    document.querySelectorAll('[data-i18n], [data-i18n-html], [data-i18n-ph]')
  ) as HTMLElement[];

  type Entry = { kind: 'text' | 'html' | 'ph'; key: string; en: string };
  const cache = new Map<HTMLElement, Entry>();
  for (const el of nodes) {
    if (el.hasAttribute('data-i18n-html')) {
      cache.set(el, { kind: 'html', key: el.getAttribute('data-i18n-html')!, en: el.innerHTML });
    } else if (el.hasAttribute('data-i18n-ph')) {
      cache.set(el, { kind: 'ph', key: el.getAttribute('data-i18n-ph')!, en: (el as HTMLInputElement).placeholder });
    } else {
      cache.set(el, { kind: 'text', key: el.getAttribute('data-i18n')!, en: el.textContent || '' });
    }
  }

  function apply(lang: string) {
    const table = T[lang];
    for (const [el, entry] of cache) {
      const value = lang === 'en' || !table || table[entry.key] == null ? entry.en : table[entry.key];
      if (entry.kind === 'html') el.innerHTML = value;
      else if (entry.kind === 'ph') (el as HTMLInputElement).placeholder = value;
      else el.textContent = value;
    }
    root.setAttribute('lang', lang === 'zh' ? 'zh-Hans' : lang);
    if (current) current.textContent = LABELS[lang] || 'EN';
    menu?.querySelectorAll('button').forEach((b) =>
      b.classList.toggle('active', b.getAttribute('data-lang') === lang)
    );
    try { localStorage.setItem(STORAGE_KEY, lang); } catch {}
  }

  function detectInitial(): string {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && (saved === 'en' || saved === 'th' || saved === 'zh')) return saved;
    } catch {}
    const nav = (navigator.language || '').toLowerCase();
    if (nav.startsWith('th')) return 'th';
    if (nav.startsWith('zh')) return 'zh';
    return 'en';
  }

  const openMenu = (open?: boolean) => {
    const isOpen = open ?? !langEl?.classList.contains('open');
    langEl?.classList.toggle('open', isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
  };

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    openMenu();
  });

  menu?.querySelectorAll('button').forEach((b) => {
    b.addEventListener('click', () => {
      apply(b.getAttribute('data-lang') || 'en');
      openMenu(false);
    });
  });

  document.addEventListener('click', (e) => {
    if (langEl && !langEl.contains(e.target as Node)) openMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') openMenu(false);
  });

  apply(detectInitial());
</script>
