---
const langs = [
  { code: 'en', label: 'English', short: 'EN' },
  { code: 'th', label: 'ไทย', short: 'ไทย' },
  { code: 'zh', label: '中文', short: '中文' },
];
---

<div class="lang" id="lang">
  <button class="lang-btn" id="lang-btn" aria-haspopup="true" aria-expanded="false" aria-label="Change language">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18" />
      <path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z" />
    </svg>
    <span id="lang-current">EN</span>
  </button>
  <ul class="lang-menu" id="lang-menu" role="menu">
    {langs.map((l) => (
      <li><button type="button" role="menuitem" data-lang={l.code}>{l.label}</button></li>
    ))}
  </ul>
</div>

<style>
  .lang {
    position: relative;
    font-family: 'Work Sans', sans-serif;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    color: #000;
    background: transparent;
    border: 2px solid #000;
    padding: 5px 11px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.1s, color 0.1s;
  }

  .lang-btn:hover {
    background: #000;
    color: #fff;
  }

  .lang-btn svg {
    width: 15px;
    height: 15px;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 120px;
    list-style: none;
    margin: 0;
    padding: 0;
    background: #fff;
    border: 3px solid #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s;
  }

  .lang.open .lang-menu {
    opacity: 1;
    pointer-events: auto;
  }

  .lang-menu button {
    width: 100%;
    text-align: left;
    font-family: 'Work Sans', sans-serif;
    font-size: 13px;
    color: #000;
    background: transparent;
    border: none;
    padding: 8px 12px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: background 0.1s, color 0.1s;
  }

  .lang-menu button:hover {
    background: #000;
    color: #fff;
  }

  .lang-menu button.active {
    background: #000;
    color: #fff;
    font-weight: 600;
  }

  .lang-menu li + li {
    border-top: 1px solid #000;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-menu { transition: none; }
  }
</style>

