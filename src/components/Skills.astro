<section id="skills">
  <div class="container">
    <div class="reveal">
      <div class="sec-label" data-i18n="skills.label">Skills</div>
      <div class="sec-title" data-i18n="skills.title">What I work with.</div>
    </div>
    <div class="skills-grid reveal">
      <div>
        <div class="skill-group-label" data-i18n="skills.core">Core Languages</div>
        <div class="skill-chips">
          <span class="chip chip-core">Python</span>
          <span class="chip chip-core">TypeScript</span>
          <span class="chip chip-core">JavaScript</span>
          <span class="chip chip-core">SQL</span>
          <span class="chip chip-core">Bash</span>
          <span class="chip">C / C++</span>
          <span class="chip">PHP</span>
          <span class="chip">Go</span>
          <span class="chip">Java</span>
        </div>
      </div>
      <div>
        <div class="skill-group-label" data-i18n="skills.frameworks">Frameworks & Tools</div>
        <div class="skill-chips">
          <span class="chip chip-core">FastAPI</span>
          <span class="chip chip-core">React</span>
          <span class="chip chip-core">GraphQL</span>
          <span class="chip chip-core">Docker</span>
          <span class="chip chip-core">Git / GitHub</span>
          <span class="chip">Nginx</span>
          <span class="chip">React Native</span>
          <span class="chip">Postman</span>
          <span class="chip">Linux CLI</span>
        </div>
      </div>
      <div>
        <div class="skill-group-label" data-i18n="skills.security">Security & Networking</div>
        <div class="skill-chips">
          <span class="chip chip-green">OWASP Top 10</span>
          <span class="chip chip-green">Secure Coding</span>
          <span class="chip chip-green">VAPT</span>
          <span class="chip chip-green">TCP/IP</span>
          <span class="chip chip-green">HTTP/S</span>
          <span class="chip">Burp Suite</span>
          <span class="chip">Nmap</span>
          <span class="chip">Wireshark</span>
        </div>
      </div>
    </div>

    <!-- Recognition -->
    <div class="reveal" style="margin-top:var(--sp-6);">
      <div class="skill-group-label" data-i18n="skills.recognition">Recognition</div>
      <div style="display:flex;flex-wrap:wrap;gap:var(--sp-3);">
        <div class="recognition-card">
          <div class="recognition-title" data-i18n="rec.kucoupon.t">Excellent Reward — KU-Coupon</div>
          <div class="recognition-sub" data-i18n="rec.kucoupon.s">Best solution for UN SDGs · KU, 2025</div>
        </div>
        <div class="recognition-card">
          <div class="recognition-title" data-i18n="rec.demoday.t">Demo Day — Hackathon Thailand League</div>
          <div class="recognition-sub" data-i18n="rec.demoday.s">Presented at TrueDigital · 2023</div>
        </div>
        <div class="recognition-card">
          <div class="recognition-title" data-i18n="rec.stupid.t">Stupid Hackathon #7, #8 · Participant, #9 · Staff</div>
          <div class="recognition-sub" data-i18n="rec.stupid.s">3 consecutive years · Creatorsgarten</div>
        </div>
        <div class="recognition-card">
          <div class="recognition-title" data-i18n="rec.toptalent.t">Thailand Cyber Top Talent 2022</div>
          <div class="recognition-sub" data-i18n="rec.toptalent.s">NCSA × Huawei national program</div>
        </div>
      </div>
    </div>
  </div>
</section>
